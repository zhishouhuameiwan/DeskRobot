# nginx 官方镜像启动时会把 ${SECRET_PATH} 替换成 .env 里的值。
# 不带密钥路径的请求一律直接断开（444），扫描器看不到后面有什么服务。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_tokens off;
    client_max_body_size 8m;

    # 设备的语音长连接
    location /${SECRET_PATH}/xiaozhi/v1/ {
        proxy_pass http://xiaozhi-esp32-server:8000/xiaozhi/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # 设备开机时来这里拿 WebSocket 地址
    location /${SECRET_PATH}/xiaozhi/ota/ {
        proxy_pass http://xiaozhi-esp32-server:8003/xiaozhi/ota/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 摄像头拍照后的看图接口
    location = /${SECRET_PATH}/mcp/vision/explain {
        proxy_pass http://xiaozhi-esp32-server:8003/mcp/vision/explain;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location / {
        return 444;
    }
}
