# 复制为 .env 后填写。这个文件里有密钥，不要外传、不要提交到 git。

# ---------- 必填 ----------
# 阿里云服务器的公网 IP
PUBLIC_HOST=
# DeepSeek 开放平台的 API Key：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---------- 选填，但强烈建议 ----------
# 阿里云百炼 API Key：https://bailian.console.aliyun.com/
#   填了：流式语音识别 + CosyVoice 童声 + 通义看图，延迟低，2核2G 服务器就够
#   不填：本地 FunASR 识别（要 4G 内存）+ EdgeTTS 成人女声 + DeepSeek 看图
DASHSCOPE_API_KEY=
# 百炼接入地址（选填）。普通 Key 留空即可；Token Plan / 业务空间的 Key 填控制台给的专属地址，
# 例如 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 部署脚本会实测这个 Key 能做什么，不能用的项目自动换成备用方案。
DASHSCOPE_BASE_URL=

# 和风天气（选填）：填了 Mercury 才能回答"今天外面几度呀"。每天有免费额度。
#   Key 申请：https://console.qweather.com/#/apps/create-key/over
#   API Host 在这里看：https://console.qweather.com/setting?lang=zh
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# ---------- 个性化 ----------
# 孩子的小名，Mercury 会这样称呼她
CHILD_NAME=小朋友
# Mercury 的声音（百炼 CosyVoice 音色，留空用 longjielidou_v2）。童声可选：
#   longjielidou_v2 阳光顽皮男童 / longling_v2 稚气女童 / longhuhu 天真烂漫女童 / longniuniu 阳光男童
# 部署时会实测这个音色能不能用。
TTS_VOICE=
# Token Plan 套餐用的是 qwen-audio-3.0-tts-plus，没有童声，系统音色只有两个：
#   longanlingxin 知心温暖女声（默认） / longanlufeng 明亮开朗男声
QWEN_TTS_VOICE=

# ---------- 一般不用改 ----------
# 网关对外端口：要在阿里云安全组里放行这个 TCP 端口
GATEWAY_PORT=18080
# 访问密钥路径和签名密钥：留空则 deploy.sh 自动生成并写回
SECRET_PATH=
AUTH_KEY=
# 以下由 deploy.sh 自动写入
NGINX_IMAGE=
COMPOSE_FILE=
